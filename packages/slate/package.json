{
  "name": "@slate-terminal/core",
  "version": "2.1.0",
  "description": "API TypeScript estável para interfaces de terminal com Node.js, teclado e mouse.",
  "keywords": ["terminal-ui", "tui", "nodejs", "typescript", "tsx", "ink-alternative", "ansi", "mouse", "keyboard", "interactive-cli", "terminal-components"],
  "repository": { "type": "git", "url": "https://github.com/AnThophicous/Slate.git", "directory": "packages/slate" },
  "homepage": "https://github.com/AnThophicous/Slate/tree/main/packages/slate",
  "bugs": { "url": "https://github.com/AnThophicous/Slate/issues" },
  "license": "Apache-2.0",
  "engines": { "node": ">=18" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js",
      "default": "./dist/jsx-runtime.js"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "optionalDependencies": {
    "@slate-terminal/native": "2.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/index.test.mjs test/composition.test.mjs"
  }
}
